{
  "_comment": "Machine-readable config for scripts/scrape.py. Human context in evidence-for-essa.md. orderby/order make the newest-first assumption behind early_stop explicit. Rated only (2026-08-31): programs whose evidence_rating is No Evidence or N/A are staged as filtered_items and inserted as excluded essa_no_evidence rows, description or not.",
  "request_delay": 5,
  "discovery": "api",
  "discovery_url": "https://evidenceforessa.org/wp-json/wp/v2/program",
  "api": {
    "params": {
      "per_page": 100,
      "_fields": "id,slug,title,link,acf",
      "orderby": "date",
      "order": "desc"
    },
    "pagination": {
      "param": "page",
      "start": 1,
      "pages": 13
    },
    "json_paths": {
      "items": "",
      "title": "title/rendered",
      "url": "link",
      "description": "acf/program_description",
      "description_fallback": "acf/program_summary",
      "type": "acf/program_type",
      "tags": "acf/grade"
    },
    "extra_fields": {
      "evidence_rating": "acf/evidence_rating",
      "effect_size": "acf/effect_size",
      "number_of_studies": "acf/number_of_studies",
      "number_of_students": "acf/number_of_students",
      "programs_designed_for": "acf/programs_designed_for"
    }
  },
  "exclude_when": [
    {"field": "evidence_rating", "values": ["No Evidence", "N/A"], "reason": "essa_no_evidence"}
  ],

  "robots_txt": "https://evidenceforessa.org/robots.txt",
  "test": {
    "url": "https://evidenceforessa.org/wp-json/wp/v2/program?per_page=5&page=1&_fields=id,slug,title,link,acf",
    "expected_item_count": 5
  },
  "early_stop": true
}
